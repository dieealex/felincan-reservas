<section class="intro">
  <h1>Servicios para mascotas</h1>
  <p>Consultá el catálogo de cuidado, higiene y bienestar.</p>
</section>

<section class="panel">
  <h2>Agregar un servicio</h2>
  <p>Formulario de administración del catálogo.</p>

  <form id="serviceForm">
    <div class="form-grid">
      <label for="name">
        Nombre
        <input id="name" name="name" required>
      </label>

      <label for="category">
        Categoría
        <input
          id="category"
          name="category"
          placeholder="Ejemplo: higiene o paseos"
          required
        >
      </label>

      <label for="duration">
        Duración en minutos
        <input
          id="duration"
          name="duration"
          type="number"
          min="1"
          step="any"
          required
        >
      </label>

      <label for="price">
        Precio en pesos
        <input
          id="price"
          name="price"
          type="number"
          min="0"
          step="0.01"
          required
        >
      </label>
    </div>

    <label for="description">
      Descripción
      <textarea
        id="description"
        name="description"
        rows="3"
        required
      ></textarea>
    </label>

    <label class="checkbox-label" for="available">
      <input id="available" name="available" type="checkbox" checked>
      Disponible para reservar
    </label>

    <button type="submit">Agregar servicio</button>
    <p id="formMessage" role="status"></p>
  </form>
</section>

<section>
  <h2>Catálogo de servicios</h2>

  <div id="services" class="service-grid">
    {{#each services}}
      <article class="service-card">
        <h3>{{name}}</h3>
        <p>{{description}}</p>
        <p>Duración: {{duration}} minutos</p>
        <p>Precio: ${{price}}</p>
        <p>Categoría: {{category}}</p>
        <p class="availability">
          {{#if available}}
            Disponible
          {{else}}
            No disponible
          {{/if}}
        </p>
      </article>
    {{else}}
      <p>No hay servicios cargados.</p>
    {{/each}}
  </div>
</section>